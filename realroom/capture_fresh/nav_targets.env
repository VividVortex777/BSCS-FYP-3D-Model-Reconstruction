# Paths are written relative to the repository root via ${FYP_ROOT}, which
# scripts/fyp_env.sh sets (from the clone's own location) and every consumer
# sources before loading this file. Keep the plain ${FYP_ROOT} form: the
# Python readers expand it with os.path.expandvars.
FYP_MAP=${FYP_ROOT}/realroom/capture_fresh/capture_fresh_baked.yaml
FYP_WORLD=${FYP_ROOT}/realroom/capture_fresh/realroom_capture_fresh_world.sdf
FYP_WORLD_NAME=capture_fresh
SPAWN_X=8.01
SPAWN_Y=13.73
GOAL_X=0.81
GOAL_Y=17.58
